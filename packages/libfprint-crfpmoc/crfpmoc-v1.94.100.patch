From 24900962c0ecbbc1c0cbc8428dee5d356e8d5f06 Mon Sep 17 00:00:00 2001
From: =?UTF-8?q?Marco=20Trevisan=20=28Trevi=C3=B1o=29?= <mail@3v1n0.net>
Date: Tue, 7 Jul 2026 12:35:26 +0200
Subject: [PATCH 06/39] fpi-device: Open udev FD's on device open

This is what all our udev devices do so far, so there's no need to keep
it in each implementation
---
 libfprint/fp-device-private.h |  3 ++
 libfprint/fp-device.c         | 75 +++++++++++++++++++++++++++++++++++
 libfprint/fpi-device.c        | 75 +++++++++++++++++++++++++++++++++++
 libfprint/fpi-device.h        |  2 +
 meson.build                   |  2 +-
 5 files changed, 156 insertions(+), 1 deletion(-)

diff --git a/libfprint/fp-device-private.h b/libfprint/fp-device-private.h
index c8253c62..820dd73f 100644
--- a/libfprint/fp-device-private.h
+++ b/libfprint/fp-device-private.h
@@ -48,8 +48,11 @@ typedef struct
   struct
   {
     gchar *spidev_path;
+    gint   spidev_fd;
     gchar *hidraw_path;
+    gint   hidraw_fd;
     gchar *misc_path;
+    gint   misc_fd;
   } udev_data;
 
   gboolean        is_removed;
diff --git a/libfprint/fp-device.c b/libfprint/fp-device.c
index ced7774f..b087bcab 100644
--- a/libfprint/fp-device.c
+++ b/libfprint/fp-device.c
@@ -23,6 +23,11 @@
 
 #include "fp-device-private.h"
 
+#include <fcntl.h>
+#include <glib-unix.h>
+#include <glib/gstdio.h>
+#include <unistd.h>
+
 /**
  * SECTION: fp-device
  * @title: FpDevice
@@ -239,6 +244,10 @@ fp_device_finalize (GObject *object)
   g_clear_pointer (&priv->udev_data.spidev_path, g_free);
   g_clear_pointer (&priv->udev_data.hidraw_path, g_free);
 
+  g_clear_fd (&priv->udev_data.spidev_fd, NULL);
+  g_clear_fd (&priv->udev_data.hidraw_fd, NULL);
+  g_clear_fd (&priv->udev_data.misc_fd, NULL);
+
   G_OBJECT_CLASS (fp_device_parent_class)->finalize (object);
 }
 
@@ -658,6 +667,33 @@ fp_device_class_init (FpDeviceClass *klass)
 static void
 fp_device_init (FpDevice *self)
 {
+  FpDevicePrivate *priv = fp_device_get_instance_private (self);
+
+  priv->udev_data.spidev_fd = -1;
+  priv->udev_data.hidraw_fd = -1;
+  priv->udev_data.misc_fd = -1;
+}
+
+static gboolean
+fp_device_open_udev_fd (const gchar *path,
+                        gint        *fd,
+                        GError     **error)
+{
+  g_return_val_if_fail (path != NULL, FALSE);
+  g_return_val_if_fail (fd != NULL, FALSE);
+
+  *fd = g_open (path, O_RDWR, 0);
+  if (*fd < 0)
+    {
+      g_set_error (error,
+                   G_IO_ERROR,
+                   g_io_error_from_errno (errno),
+                   "Failed to open udev path %s",
+                   path);
+      return FALSE;
+    }
+
+  return TRUE;
 }
 
 /**
@@ -875,6 +911,7 @@ fp_device_open (FpDevice           *device,
                 gpointer            user_data)
 {
   g_autoptr(GTask) task = NULL;
+  FpDeviceClass *cls = FP_DEVICE_GET_CLASS (device);
   FpDevicePrivate *priv = fp_device_get_instance_private (device);
   GError *error = NULL;
 
@@ -907,7 +944,45 @@ fp_device_open (FpDevice           *device,
       break;
 
     case FP_DEVICE_TYPE_VIRTUAL:
+      break;
+
     case FP_DEVICE_TYPE_UDEV:
+      {
+        g_autofd int spidev_fd = -1;
+        g_autofd int hidraw_fd = -1;
+        g_autofd int misc_fd = -1;
+
+        if ((cls->id_table->udev_types & FPI_DEVICE_UDEV_SUBTYPE_SPIDEV) &&
+            !fp_device_open_udev_fd (priv->udev_data.spidev_path,
+                                     &spidev_fd,
+                                     &error))
+          {
+            g_task_return_error (task, error);
+            return;
+          }
+
+        if ((cls->id_table->udev_types & FPI_DEVICE_UDEV_SUBTYPE_HIDRAW) &&
+            !fp_device_open_udev_fd (priv->udev_data.hidraw_path,
+                                     &hidraw_fd,
+                                     &error))
+          {
+            g_task_return_error (task, error);
+            return;
+          }
+
+        if ((cls->id_table->udev_types & FPI_DEVICE_UDEV_SUBTYPE_MISC) &&
+            !fp_device_open_udev_fd (priv->udev_data.misc_path,
+                                     &misc_fd,
+                                     &error))
+          {
+            g_task_return_error (task, error);
+            return;
+          }
+
+        priv->udev_data.spidev_fd = g_steal_fd (&spidev_fd);
+        priv->udev_data.hidraw_fd = g_steal_fd (&hidraw_fd);
+        priv->udev_data.misc_fd = g_steal_fd (&misc_fd);
+      }
       break;
 
     default:
diff --git a/libfprint/fpi-device.c b/libfprint/fpi-device.c
index a70db5c4..e84fc82c 100644
--- a/libfprint/fpi-device.c
+++ b/libfprint/fpi-device.c
@@ -22,8 +22,13 @@
 #include <math.h>
 #include <fcntl.h>
 #include <errno.h>
+#include <unistd.h>
 #include <gmodule.h>
 
+#include <glib-unix.h>
+
+#include <glib/gstdio.h>
+
 #include "fpi-log.h"
 
 #include "fp-device-private.h"
@@ -530,6 +535,45 @@ fpi_device_get_udev_data (FpDevice *device, FpiDeviceUdevSubtypeFlags subtype)
     }
 }
 
+/**
+ * fpi_device_get_udev_fd:
+ * @device: The #FpDevice
+ * @subtype: Which subtype to get a file descriptor for
+ *
+ * Get an open subtype-specific file descriptor for this #FpDevice. Only
+ * permissible to call if the #FpDevice is opened and of type
+ * %FP_DEVICE_TYPE_UDEV.
+ *
+ * Returns: A file descriptor or -1 if not available for @subtype.
+ */
+gint
+fpi_device_get_udev_fd (FpDevice *device, FpiDeviceUdevSubtypeFlags subtype)
+{
+  FpDevicePrivate *priv = fp_device_get_instance_private (device);
+
+  g_return_val_if_fail (FP_IS_DEVICE (device), -1);
+  g_return_val_if_fail (priv->is_open ||
+                        priv->current_action == FPI_DEVICE_ACTION_OPEN, -1);
+  g_return_val_if_fail (priv->type == FP_DEVICE_TYPE_UDEV, -1);
+
+  switch (subtype)
+    {
+    case FPI_DEVICE_UDEV_SUBTYPE_HIDRAW:
+      g_return_val_if_fail (priv->udev_data.hidraw_fd >= 0, -1);
+      return priv->udev_data.hidraw_fd;
+
+    case FPI_DEVICE_UDEV_SUBTYPE_SPIDEV:
+      g_return_val_if_fail (priv->udev_data.spidev_fd >= 0, -1);
+      return priv->udev_data.spidev_fd;
+
+    case FPI_DEVICE_UDEV_SUBTYPE_MISC:
+      g_return_val_if_fail (priv->udev_data.misc_fd >= 0, -1);
+      return priv->udev_data.misc_fd;
+    }
+
+  g_return_val_if_reached (-1);
+}
+
 /**
  * fpi_device_get_virtual_env:
  * @device: The #FpDevice
@@ -1322,7 +1366,38 @@ fpi_device_close_complete (FpDevice *device, GError *error)
       break;
 
     case FP_DEVICE_TYPE_VIRTUAL:
+      break;
+
     case FP_DEVICE_TYPE_UDEV:
+      {
+        g_autofd int spidev_fd = g_steal_fd (&priv->udev_data.spidev_fd);
+        g_autofd int hidraw_fd = g_steal_fd (&priv->udev_data.hidraw_fd);
+        g_autofd int misc_fd = g_steal_fd (&priv->udev_data.misc_fd);
+
+        if (!g_clear_fd (&spidev_fd, &nested_error))
+          {
+            if (error == NULL)
+              g_propagate_prefixed_error (&error, nested_error, "Failed to close spidev fd: ");
+            else
+              g_warning ("Failed to close spidev fd: %s", nested_error->message);
+          }
+
+        if (!g_clear_fd (&hidraw_fd, &nested_error))
+          {
+            if (error == NULL)
+              g_propagate_prefixed_error (&error, nested_error, "Failed to close hidraw fd: ");
+            else
+              g_warning ("Failed to close hidraw fd: %s", nested_error->message);
+          }
+
+        if (!g_clear_fd (&misc_fd, &nested_error))
+          {
+            if (error == NULL)
+              g_propagate_prefixed_error (&error, nested_error, "Failed to close misc fd: ");
+            else
+              g_warning ("Failed to close misc fd: %s", nested_error->message);
+          }
+      }
       break;
 
     default:
diff --git a/libfprint/fpi-device.h b/libfprint/fpi-device.h
index c4e663da..603fe8d0 100644
--- a/libfprint/fpi-device.h
+++ b/libfprint/fpi-device.h
@@ -236,6 +236,8 @@ GUsbDevice  *fpi_device_get_usb_device (FpDevice *device);
 const gchar *fpi_device_get_virtual_env (FpDevice *device);
 gpointer     fpi_device_get_udev_data (FpDevice                 *device,
                                        FpiDeviceUdevSubtypeFlags subtype);
+gint         fpi_device_get_udev_fd (FpDevice                 *device,
+                                     FpiDeviceUdevSubtypeFlags subtype);
 
 
 FpiDeviceAction fpi_device_get_current_action (FpDevice *device);
diff --git a/meson.build b/meson.build
index ab09dc1d..46a664ed 100644
--- a/meson.build
+++ b/meson.build
@@ -30,7 +30,7 @@ if libfprint_sanitizers == ['none']
   libfprint_sanitizers = []
 endif
 
-glib_min_version = '2.68'
+glib_min_version = '2.76'
 
 glib_version_def = 'GLIB_VERSION_@0@_@1@'.format(
     glib_min_version.split('.')[0], glib_min_version.split('.')[1])
