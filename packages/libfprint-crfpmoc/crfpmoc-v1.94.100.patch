+                                              NULL, 0, sizeof (struct crfpmoc_ec_response_get_protocol_info));
+      crfpmoc_ec_transfer_submit_cmd (transfer, fpi_device_get_cancellable (device),
+                                      crfpmoc_open_proto_info_cb, ssm);
+      break;
