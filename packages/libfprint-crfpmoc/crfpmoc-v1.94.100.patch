From d5531923cb935c11f29dd99826872c28ba43155c Mon Sep 17 00:00:00 2001
From: shimon <137411+shimon@users.noreply.github.com>
Date: Tue, 17 Nov 2026 08:35:40 -0500
Subject: [PATCH 39/39] crfpmoc: Keep the seed and context across restarts

The FPMCU derives the template encryption key from the seed and accepts
a seed only once per FPMCU boot. With a fresh random seed every time
fprintd starts, templates enrolled before a reboot can no longer be
decrypted: every upload fails with EC_RES_UNAVAILABLE and verify never
succeeds again. Generate the seed and context once and keep them in a
0600 file in fprintd's state directory ($STATE_DIRECTORY, else
/var/lib/fprint).
---
 libfprint/drivers/crfpmoc/crfpmoc.c | 67 +++++++++++++++++++++++++----
 1 file changed, 59 insertions(+), 8 deletions(-)

diff --git a/libfprint/drivers/crfpmoc/crfpmoc.c b/libfprint/drivers/crfpmoc/crfpmoc.c
index 24d65f55..0bf128b7 100644
--- a/libfprint/drivers/crfpmoc/crfpmoc.c
+++ b/libfprint/drivers/crfpmoc/crfpmoc.c
@@ -23,6 +23,7 @@
 
 #define FP_COMPONENT "crfpmoc"
 
+#include <string.h>
 #include <glib-unix.h>
 #include <gio/gunixinputstream.h>
 
@@ -1026,10 +1027,63 @@ crfpmoc_open_ssm_done (FpiSsm *ssm, FpDevice *device, GError *error)
   fpi_device_open_complete (device, error);
 }
 
-/* Initialise the per-session encryption seed and user context. In emulation
- * mode fixed test values are used so the recorded ioctl replay stays
- * deterministic; on real hardware random values are generated.
+/* Initialise the encryption seed and user context.
+ *
+ * The FPMCU derives the key that encrypts the templates it hands to the host
+ * from the seed (and the context), and accepts a seed only once per FPMCU
+ * boot. The values must therefore stay the same across fprintd restarts and
+ * reboots, or templates enrolled earlier can no longer be decrypted and every
+ * upload fails with EC_RES_UNAVAILABLE. ChromeOS keeps its seed in the TPM;
+ * here it is generated once and kept in a root-only file in fprintd's state
+ * directory. In emulation mode fixed test values are used so the recorded
+ * ioctl replay stays deterministic.
  */
+#define CRFPMOC_KEYS_FILE "crfpmoc-keys"
+
+static gboolean
+crfpmoc_load_or_create_keys (guint8 *seed, gsize seed_len,
+                             guint8 *context, gsize context_len)
+{
+  g_autoptr(GError) error = NULL;
+  g_autofree gchar *path = NULL;
+  g_autofree gchar *contents = NULL;
+  const gchar *dir;
+  gsize len = 0;
+
+  dir = g_getenv ("STATE_DIRECTORY");
+  if (dir == NULL || *dir == '\0' || strchr (dir, ':') != NULL)
+    dir = "/var/lib/fprint";
+  path = g_build_filename (dir, CRFPMOC_KEYS_FILE, NULL);
+
+  if (g_file_get_contents (path, &contents, &len, NULL) &&
+      len == seed_len + context_len)
+    {
+      memcpy (seed, contents, seed_len);
+      memcpy (context, contents + seed_len, context_len);
+      fp_dbg ("Loaded persistent seed and context from %s", path);
+      return TRUE;
+    }
+
+  contents = g_malloc (seed_len + context_len);
+  for (gsize i = 0; i < seed_len + context_len; i++)
+    contents[i] = (gchar) g_random_int_range (0, 256);
+
+  if (!g_file_set_contents_full (path, contents, seed_len + context_len,
+                                 G_FILE_SET_CONTENTS_CONSISTENT, 0600, &error))
+    {
+      g_warning ("Could not store the crfpmoc seed in %s (%s); enrolled "
+                 "fingerprints will not survive a reboot", path, error->message);
+      memcpy (seed, contents, seed_len);
+      memcpy (context, contents + seed_len, context_len);
+      return FALSE;
+    }
+
+  memcpy (seed, contents, seed_len);
+  memcpy (context, contents + seed_len, context_len);
+  fp_dbg ("Created persistent seed and context in %s", path);
+  return TRUE;
+}
+
 static void
 crfpmoc_init_keys (FpiDeviceCrfpMoc *self)
 {
@@ -1045,11 +1099,8 @@ crfpmoc_init_keys (FpiDeviceCrfpMoc *self)
     }
   else
     {
-      for (size_t i = 0; i < sizeof (self->seed); i++)
-        self->seed[i] = (guint8) g_random_int_range (0, 256);
-
-      for (size_t i = 0; i < sizeof (self->context); i++)
-        self->context[i] = (guint8) g_random_int_range (0, 256);
+      crfpmoc_load_or_create_keys (self->seed, sizeof (self->seed),
+                                   self->context, sizeof (self->context));
     }
 }
 
-- 
