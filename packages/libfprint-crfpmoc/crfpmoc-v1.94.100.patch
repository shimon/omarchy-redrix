From 811609a334f6a1190236d14dd68249b56af6af2a Mon Sep 17 00:00:00 2001
From: Abhinav Baid <abhinavbaid@gmail.com>
Date: Tue, 21 May 2024 23:33:06 +0100
Subject: [PATCH 01/39] fpi-device: Add support for Misc devices

Support devices that have uncommon name by providing the name as custom
value
---
 libfprint/fp-context.c                    | 27 +++++++++-
 libfprint/fp-device-private.h             |  1 +
 libfprint/fp-device.c                     | 28 ++++++++++
 libfprint/fpi-device.c                    |  3 ++
 libfprint/fpi-device.h                    |  9 +++-
 libfprint/fprint-list-supported-devices.c | 65 ++++++++++++++++-------
 6 files changed, 113 insertions(+), 20 deletions(-)

diff --git a/libfprint/fp-context.c b/libfprint/fp-context.c
index 70d4062a..cc625f0e 100644
--- a/libfprint/fp-context.c
+++ b/libfprint/fp-context.c
@@ -479,6 +479,7 @@ fp_context_enumerate (FpContext *context)
 
     g_autoptr(GList) spidev_devices = g_udev_client_query_by_subsystem (udev_client, "spidev");
     g_autoptr(GList) hidraw_devices = g_udev_client_query_by_subsystem (udev_client, "hidraw");
+    g_autoptr(GList) misc_devices = g_udev_client_query_by_subsystem (udev_client, "misc");
 
     /* for each potential driver, try to match all requested resources. */
     for (i = 0; i < priv->drivers->len; i++)
@@ -492,7 +493,7 @@ fp_context_enumerate (FpContext *context)
 
         for (entry = cls->id_table; entry->udev_types; entry++)
           {
-            GList *matched_spidev = NULL, *matched_hidraw = NULL;
+            GList *matched_spidev = NULL, *matched_hidraw = NULL, *matched_misc = NULL;
 
             if (entry->udev_types & FPI_DEVICE_UDEV_SUBTYPE_SPIDEV)
               {
@@ -530,6 +531,23 @@ fp_context_enumerate (FpContext *context)
                 if (matched_hidraw == NULL)
                   continue;
               }
+            if (entry->udev_types & FPI_DEVICE_UDEV_SUBTYPE_MISC)
+              {
+                for (matched_misc = misc_devices; matched_misc; matched_misc = matched_misc->next)
+                  {
+                    const gchar *sysfs = g_udev_device_get_sysfs_path (matched_misc->data);
+
+                    if (!sysfs)
+                      continue;
+
+                    if (g_str_has_suffix (sysfs, entry->misc_name))
+                      break;
+                  }
+
+                /* If match was not found exit */
+                if (matched_misc == NULL)
+                  continue;
+              }
             priv->pending_devices++;
             g_async_initable_new_async (driver,
                                         G_PRIORITY_LOW,
@@ -539,6 +557,7 @@ fp_context_enumerate (FpContext *context)
                                         "fpi-driver-data", entry->driver_data,
                                         "fpi-udev-data-spidev", (matched_spidev ? g_udev_device_get_device_file (matched_spidev->data) : NULL),
                                         "fpi-udev-data-hidraw", (matched_hidraw ? g_udev_device_get_device_file (matched_hidraw->data) : NULL),
+                                        "fpi-udev-data-misc", (matched_misc ? g_udev_device_get_device_file (matched_misc->data) : NULL),
                                         NULL);
             /* remove entries from list to avoid conflicts */
             if (matched_spidev)
@@ -551,12 +570,18 @@ fp_context_enumerate (FpContext *context)
                 g_object_unref (matched_hidraw->data);
                 hidraw_devices = g_list_delete_link (hidraw_devices, matched_hidraw);
               }
+            if (matched_misc)
+              {
+                g_object_unref (matched_misc->data);
+                misc_devices = g_list_delete_link (misc_devices, matched_misc);
+              }
           }
       }
 
     /* free all unused elemnts in both lists */
     g_list_foreach (spidev_devices, (GFunc) g_object_unref, NULL);
     g_list_foreach (hidraw_devices, (GFunc) g_object_unref, NULL);
+    g_list_foreach (misc_devices, (GFunc) g_object_unref, NULL);
   }
 #endif
 
diff --git a/libfprint/fp-device-private.h b/libfprint/fp-device-private.h
index 1c3702fa..c8253c62 100644
--- a/libfprint/fp-device-private.h
+++ b/libfprint/fp-device-private.h
@@ -49,6 +49,7 @@ typedef struct
   {
     gchar *spidev_path;
     gchar *hidraw_path;
+    gchar *misc_path;
   } udev_data;
 
   gboolean        is_removed;
diff --git a/libfprint/fp-device.c b/libfprint/fp-device.c
index 115063d5..7a889a17 100644
--- a/libfprint/fp-device.c
+++ b/libfprint/fp-device.c
@@ -53,6 +53,7 @@ enum {
   PROP_FPI_USB_DEVICE,
   PROP_FPI_UDEV_DATA_SPIDEV,
   PROP_FPI_UDEV_DATA_HIDRAW,
+  PROP_FPI_UDEV_DATA_MISC,
   PROP_FPI_DRIVER_DATA,
   N_PROPS
 };
@@ -307,6 +308,13 @@ fp_device_get_property (GObject    *object,
         g_value_set_string (value, NULL);
       break;
 
+    case PROP_FPI_UDEV_DATA_MISC:
+      if (cls->type == FP_DEVICE_TYPE_UDEV)
+        g_value_set_string (value, priv->udev_data.misc_path);
+      else
+        g_value_set_string (value, NULL);
+      break;
+
     default:
       G_OBJECT_WARN_INVALID_PROPERTY_ID (object, prop_id, pspec);
     }
@@ -353,6 +361,13 @@ fp_device_set_property (GObject      *object,
         g_assert (g_value_get_string (value) == NULL);
       break;
 
+    case PROP_FPI_UDEV_DATA_MISC:
+      if (cls->type == FP_DEVICE_TYPE_UDEV)
+        priv->udev_data.misc_path = g_value_dup_string (value);
+      else
+        g_assert (g_value_get_string (value) == NULL);
+      break;
+
     case PROP_FPI_DRIVER_DATA:
       priv->driver_data = g_value_get_uint64 (value);
       break;
@@ -583,6 +598,19 @@ fp_device_class_init (FpDeviceClass *klass)
                          "Private: The path to /dev/hidrawN",
                          NULL,
                          G_PARAM_STATIC_STRINGS | G_PARAM_READWRITE | G_PARAM_CONSTRUCT_ONLY);
+  /**
+   * FpDevice::fpi-udev-data-misc: (skip)
+   *
+   * This property is only for internal purposes.
+   *
+   * Stability: private
+   */
+  properties[PROP_FPI_UDEV_DATA_MISC] =
+    g_param_spec_string ("fpi-udev-data-misc",
+                         "Udev data: misc path",
+                         "Private: The path to /dev/{misc_name}",
+                         NULL,
+                         G_PARAM_STATIC_STRINGS | G_PARAM_READWRITE | G_PARAM_CONSTRUCT_ONLY);
 
   /**
    * FpDevice::fpi-driver-data: (skip)
diff --git a/libfprint/fpi-device.c b/libfprint/fpi-device.c
index 9500b3ac..a70db5c4 100644
--- a/libfprint/fpi-device.c
+++ b/libfprint/fpi-device.c
@@ -521,6 +521,9 @@ fpi_device_get_udev_data (FpDevice *device, FpiDeviceUdevSubtypeFlags subtype)
     case FPI_DEVICE_UDEV_SUBTYPE_SPIDEV:
       return priv->udev_data.spidev_path;
 
+    case FPI_DEVICE_UDEV_SUBTYPE_MISC:
+      return priv->udev_data.misc_path;
+
     default:
       g_return_val_if_reached (NULL);
       return NULL;
diff --git a/libfprint/fpi-device.h b/libfprint/fpi-device.h
index b17c10df..c4e663da 100644
--- a/libfprint/fpi-device.h
+++ b/libfprint/fpi-device.h
@@ -28,12 +28,14 @@
  * FpiDeviceUdevSubtypeFlags:
  * @FPI_DEVICE_UDEV_SUBTYPE_SPIDEV: The device requires an spidev node
  * @FPI_DEVICE_UDEV_SUBTYPE_HIDRAW: The device requires a hidraw node
+ * @FPI_DEVICE_UDEV_SUBTYPE_MISC: The device requires a misc node
  *
  * Bitfield of required hardware resources for a udev-backed device.
  */
 typedef enum {
   FPI_DEVICE_UDEV_SUBTYPE_SPIDEV = 1 << 0,
   FPI_DEVICE_UDEV_SUBTYPE_HIDRAW = 1 << 1,
+  FPI_DEVICE_UDEV_SUBTYPE_MISC = 1 << 2,
 } FpiDeviceUdevSubtypeFlags;
 
 /**
@@ -45,6 +47,7 @@ typedef enum {
  * @udev_types: Subtypes for udev-based devices
  * @spi_acpi_id: ACPI ID (for SPI devices)
  * @hid_id: HID device identifier (for HID devices)
+ * @misc_name: Misc name (for MISC devices)
  *
  * An entry in the table of supported hardware. For USB devices, the product ID
  * and vendor ID should be provided. The optional @driver_data field defaults
@@ -65,7 +68,11 @@ struct _FpIdEntry
     struct
     {
       FpiDeviceUdevSubtypeFlags udev_types;
-      const gchar              *spi_acpi_id;
+      union
+      {
+        const gchar *spi_acpi_id;
+        const gchar *misc_name;
+      };
       struct
       {
         guint pid;
diff --git a/libfprint/fprint-list-supported-devices.c b/libfprint/fprint-list-supported-devices.c
index 1b02c0b2..b277076b 100644
--- a/libfprint/fprint-list-supported-devices.c
+++ b/libfprint/fprint-list-supported-devices.c
@@ -29,7 +29,7 @@
 GHashTable *printed = NULL;
 
 static void
-insert_drivers (GList **usb_list, GList **spi_list)
+insert_drivers (GList **usb_list, GList **spi_list, GList **misc_list)
 {
   g_autoptr(GArray) drivers = fpi_get_driver_types ();
   gint i;
@@ -67,28 +67,44 @@ insert_drivers (GList **usb_list, GList **spi_list)
         case FP_DEVICE_TYPE_UDEV:
           for (entry = cls->id_table; entry->udev_types; entry++)
             {
-              char *key;
+              g_autofree char *key = NULL;
 
-              /* Need SPI device */
-              if ((entry->udev_types & FPI_DEVICE_UDEV_SUBTYPE_SPIDEV) == 0)
-                continue;
-
-              key = g_strdup_printf ("SPI:%s:%04x:%04x", entry->spi_acpi_id, entry->hid_id.vid, entry->hid_id.pid);
-
-              if (g_hash_table_lookup (printed, key) != NULL)
+              if ((entry->udev_types & FPI_DEVICE_UDEV_SUBTYPE_MISC) == FPI_DEVICE_UDEV_SUBTYPE_MISC)
                 {
-                  g_free (key);
-                  continue;
+                  key = g_strdup_printf ("misc:%s", entry->misc_name);
+                }
+              else
+                {
+                  /* Need SPI device */
+                  if ((entry->udev_types & FPI_DEVICE_UDEV_SUBTYPE_SPIDEV) == 0)
+                    continue;
+
+                  key = g_strdup_printf ("SPI:%s:%04x:%04x", entry->spi_acpi_id,
+                                         entry->hid_id.vid, entry->hid_id.pid);
                 }
 
-              g_hash_table_insert (printed, key, GINT_TO_POINTER (1));
+              if (g_hash_table_insert (printed, g_steal_pointer (&key), GINT_TO_POINTER (1)))
+                continue;
 
-              if (entry->udev_types & FPI_DEVICE_UDEV_SUBTYPE_HIDRAW)
-                *spi_list = g_list_prepend (*spi_list,
-                                            g_strdup_printf ("%s | %04x:%04x | %s\n", entry->spi_acpi_id, entry->hid_id.vid, entry->hid_id.pid, cls->full_name));
+              if ((entry->udev_types & FPI_DEVICE_UDEV_SUBTYPE_MISC) == FPI_DEVICE_UDEV_SUBTYPE_MISC)
+                {
+                  *misc_list = g_list_prepend (*misc_list,
+                                               g_strdup_printf ("%s | %s\n",
+                                                                entry->misc_name, cls->full_name));
+                }
+              else if (entry->udev_types & FPI_DEVICE_UDEV_SUBTYPE_HIDRAW)
+                {
+                  *spi_list = g_list_prepend (*spi_list,
+                                              g_strdup_printf ("%s | %04x:%04x | %s\n",
+                                                               entry->spi_acpi_id, entry->hid_id.vid,
+                                                               entry->hid_id.pid, cls->full_name));
+                }
               else
-                *spi_list = g_list_prepend (*spi_list,
-                                            g_strdup_printf ("%s | - | %s\n", entry->spi_acpi_id, cls->full_name));
+                {
+                  *spi_list = g_list_prepend (*spi_list,
+                                              g_strdup_printf ("%s | - | %s\n",
+                                                               entry->spi_acpi_id, cls->full_name));
+                }
             }
           break;
 
@@ -104,6 +120,7 @@ main (int argc, char **argv)
 {
   GList *usb_list = NULL;
   GList *spi_list = NULL;
+  GList *misc_list = NULL;
   GList *l;
 
   setlocale (LC_ALL, "");
@@ -120,7 +137,7 @@ main (int argc, char **argv)
   g_print ("This is a list of supported devices in libfprint's development version. Those drivers might not all be available in the stable, released version. If in doubt, contact your distribution or systems integrator for details.\n");
   g_print ("\n");
 
-  insert_drivers (&usb_list, &spi_list);
+  insert_drivers (&usb_list, &spi_list, &misc_list);
 
   g_print ("## USB devices\n");
   g_print ("\n");
@@ -148,6 +165,18 @@ main (int argc, char **argv)
 
   g_list_free_full (g_steal_pointer (&spi_list), g_free);
 
+  g_print ("## Misc devices\n");
+  g_print ("\n");
+  g_print ("Name | Driver\n");
+  g_print ("------------ | ------------\n");
+
+  misc_list = g_list_sort (misc_list, (GCompareFunc) g_strcmp0);
+  for (l = misc_list; l != NULL; l = l->next)
+    g_print ("%s", (char *) l->data);
+  g_print ("\n");
+
+  g_list_free_full (g_steal_pointer (&misc_list), g_free);
+
 
   g_hash_table_destroy (printed);
 
-- 
2.56.0


From 4dc0c79fadf6912ca59587616cccf2773ea5630c Mon Sep 17 00:00:00 2001
From: =?UTF-8?q?Marco=20Trevisan=20=28Trevi=C3=B1o=29?= <mail@3v1n0.net>
Date: Fri, 3 Jul 2026 17:03:26 +0200
Subject: [PATCH 02/39] fp-context: Use autpointers to manage devices lists

---
 libfprint/fp-context.c | 34 ++++++++++++++++++++--------------
 1 file changed, 20 insertions(+), 14 deletions(-)

diff --git a/libfprint/fp-context.c b/libfprint/fp-context.c
index cc625f0e..0aeb9f06 100644
--- a/libfprint/fp-context.c
+++ b/libfprint/fp-context.c
@@ -471,15 +471,18 @@ fp_context_enumerate (FpContext *context)
 #ifdef HAVE_UDEV
   {
     g_autoptr(GUdevClient) udev_client = g_udev_client_new (NULL);
+    g_autolist(GUdevDevice) spidev_devices = NULL;
+    g_autolist(GUdevDevice) hidraw_devices = NULL;
+    g_autolist(GUdevDevice) misc_devices = NULL;
 
     /* This uses a very simple algorithm to allocate devices to drivers and assumes that no two drivers will want the same device. Future improvements
      * could add a usb_discover style udev_discover that returns a score, however for internal devices the potential overlap should be very low between
      * separate drivers.
      */
 
-    g_autoptr(GList) spidev_devices = g_udev_client_query_by_subsystem (udev_client, "spidev");
-    g_autoptr(GList) hidraw_devices = g_udev_client_query_by_subsystem (udev_client, "hidraw");
-    g_autoptr(GList) misc_devices = g_udev_client_query_by_subsystem (udev_client, "misc");
+    spidev_devices = g_udev_client_query_by_subsystem (udev_client, "spidev");
+    hidraw_devices = g_udev_client_query_by_subsystem (udev_client, "hidraw");
+    misc_devices = g_udev_client_query_by_subsystem (udev_client, "misc");
 
     /* for each potential driver, try to match all requested resources. */
     for (i = 0; i < priv->drivers->len; i++)
@@ -505,10 +508,12 @@ fp_context_enumerate (FpContext *context)
                     if (strstr (sysfs, entry->spi_acpi_id))
                       break;
                   }
+
                 /* If match was not found exit */
                 if (matched_spidev == NULL)
                   continue;
               }
+
             if (entry->udev_types & FPI_DEVICE_UDEV_SUBTYPE_HIDRAW)
               {
                 for (matched_hidraw = hidraw_devices; matched_hidraw; matched_hidraw = matched_hidraw->next)
@@ -527,10 +532,12 @@ fp_context_enumerate (FpContext *context)
                     if (vendor == entry->hid_id.vid && product == entry->hid_id.pid)
                       break;
                   }
+
                 /* If match was not found exit */
                 if (matched_hidraw == NULL)
                   continue;
               }
+
             if (entry->udev_types & FPI_DEVICE_UDEV_SUBTYPE_MISC)
               {
                 for (matched_misc = misc_devices; matched_misc; matched_misc = matched_misc->next)
@@ -548,6 +555,7 @@ fp_context_enumerate (FpContext *context)
                 if (matched_misc == NULL)
                   continue;
               }
+
             priv->pending_devices++;
             g_async_initable_new_async (driver,
                                         G_PRIORITY_LOW,
@@ -555,33 +563,31 @@ fp_context_enumerate (FpContext *context)
                                         async_device_init_done_cb,
                                         context,
                                         "fpi-driver-data", entry->driver_data,
-                                        "fpi-udev-data-spidev", (matched_spidev ? g_udev_device_get_device_file (matched_spidev->data) : NULL),
-                                        "fpi-udev-data-hidraw", (matched_hidraw ? g_udev_device_get_device_file (matched_hidraw->data) : NULL),
-                                        "fpi-udev-data-misc", (matched_misc ? g_udev_device_get_device_file (matched_misc->data) : NULL),
+                                        "fpi-udev-data-spidev", (matched_spidev ?
+                                                                 g_udev_device_get_device_file (matched_spidev->data) : NULL),
+                                        "fpi-udev-data-hidraw", (matched_hidraw ?
+                                                                 g_udev_device_get_device_file (matched_hidraw->data) : NULL),
+                                        "fpi-udev-data-misc", (matched_misc ?
+                                                               g_udev_device_get_device_file (matched_misc->data) : NULL),
                                         NULL);
             /* remove entries from list to avoid conflicts */
             if (matched_spidev)
               {
-                g_object_unref (matched_spidev->data);
+                g_clear_object (&matched_spidev->data);
                 spidev_devices = g_list_delete_link (spidev_devices, matched_spidev);
               }
             if (matched_hidraw)
               {
-                g_object_unref (matched_hidraw->data);
+                g_clear_object (&matched_hidraw->data);
                 hidraw_devices = g_list_delete_link (hidraw_devices, matched_hidraw);
               }
             if (matched_misc)
               {
-                g_object_unref (matched_misc->data);
+                g_clear_object (&matched_misc->data);
                 misc_devices = g_list_delete_link (misc_devices, matched_misc);
               }
           }
       }
-
-    /* free all unused elemnts in both lists */
-    g_list_foreach (spidev_devices, (GFunc) g_object_unref, NULL);
-    g_list_foreach (hidraw_devices, (GFunc) g_object_unref, NULL);
-    g_list_foreach (misc_devices, (GFunc) g_object_unref, NULL);
   }
 #endif
 
-- 
2.56.0


From bef15739ee25f3fa14b32fce9642183496e991a0 Mon Sep 17 00:00:00 2001
From: =?UTF-8?q?Marco=20Trevisan=20=28Trevi=C3=B1o=29?= <mail@3v1n0.net>
Date: Fri, 3 Jul 2026 14:27:51 +0200
Subject: [PATCH 03/39] fp-device: Ensure that udev properties are set/get only
 on devices with proper subtype

---
 libfprint/fp-device.c | 48 +++++++++++++++++++++++++++++--------------
 1 file changed, 33 insertions(+), 15 deletions(-)

diff --git a/libfprint/fp-device.c b/libfprint/fp-device.c
index 7a889a17..e6179785 100644
--- a/libfprint/fp-device.c
+++ b/libfprint/fp-device.c
@@ -295,24 +295,39 @@ fp_device_get_property (GObject    *object,
       break;
 
     case PROP_FPI_UDEV_DATA_SPIDEV:
-      if (cls->type == FP_DEVICE_TYPE_UDEV)
-        g_value_set_string (value, priv->udev_data.spidev_path);
-      else
-        g_value_set_string (value, NULL);
+      if (cls->type == FP_DEVICE_TYPE_UDEV &&
+          cls->id_table->udev_types & FPI_DEVICE_UDEV_SUBTYPE_SPIDEV)
+        {
+          g_value_set_string (value, priv->udev_data.spidev_path);
+          break;
+        }
+
+      G_OBJECT_WARN_INVALID_PROPERTY_ID (object, prop_id, pspec);
+      g_value_set_string (value, NULL);
       break;
 
     case PROP_FPI_UDEV_DATA_HIDRAW:
-      if (cls->type == FP_DEVICE_TYPE_UDEV)
-        g_value_set_string (value, priv->udev_data.hidraw_path);
-      else
-        g_value_set_string (value, NULL);
+      if (cls->type == FP_DEVICE_TYPE_UDEV &&
+          cls->id_table->udev_types & FPI_DEVICE_UDEV_SUBTYPE_HIDRAW)
+        {
+          g_value_set_string (value, priv->udev_data.hidraw_path);
+          break;
+        }
+
+      G_OBJECT_WARN_INVALID_PROPERTY_ID (object, prop_id, pspec);
+      g_value_set_string (value, NULL);
       break;
 
     case PROP_FPI_UDEV_DATA_MISC:
-      if (cls->type == FP_DEVICE_TYPE_UDEV)
-        g_value_set_string (value, priv->udev_data.misc_path);
-      else
-        g_value_set_string (value, NULL);
+      if (cls->type == FP_DEVICE_TYPE_UDEV &&
+          cls->id_table->udev_types & FPI_DEVICE_UDEV_SUBTYPE_MISC)
+        {
+          g_value_set_string (value, priv->udev_data.misc_path);
+          break;
+        }
+
+      G_OBJECT_WARN_INVALID_PROPERTY_ID (object, prop_id, pspec);
+      g_value_set_string (value, NULL);
       break;
 
     default:
@@ -348,21 +363,24 @@ fp_device_set_property (GObject      *object,
       break;
 
     case PROP_FPI_UDEV_DATA_SPIDEV:
-      if (cls->type == FP_DEVICE_TYPE_UDEV)
+      if (cls->type == FP_DEVICE_TYPE_UDEV &&
+          cls->id_table->udev_types & FPI_DEVICE_UDEV_SUBTYPE_SPIDEV)
         priv->udev_data.spidev_path = g_value_dup_string (value);
       else
         g_assert (g_value_get_string (value) == NULL);
       break;
 
     case PROP_FPI_UDEV_DATA_HIDRAW:
-      if (cls->type == FP_DEVICE_TYPE_UDEV)
+      if (cls->type == FP_DEVICE_TYPE_UDEV &&
+          cls->id_table->udev_types & FPI_DEVICE_UDEV_SUBTYPE_HIDRAW)
         priv->udev_data.hidraw_path = g_value_dup_string (value);
       else
         g_assert (g_value_get_string (value) == NULL);
       break;
 
     case PROP_FPI_UDEV_DATA_MISC:
-      if (cls->type == FP_DEVICE_TYPE_UDEV)
+      if (cls->type == FP_DEVICE_TYPE_UDEV &&
+          cls->id_table->udev_types & FPI_DEVICE_UDEV_SUBTYPE_MISC)
         priv->udev_data.misc_path = g_value_dup_string (value);
       else
         g_assert (g_value_get_string (value) == NULL);
-- 
2.56.0


From 514621b72aa90140fd45a9bae36d6417c8c158a0 Mon Sep 17 00:00:00 2001
From: =?UTF-8?q?Marco=20Trevisan=20=28Trevi=C3=B1o=29?= <mail@3v1n0.net>
Date: Fri, 3 Jul 2026 14:30:18 +0200
Subject: [PATCH 04/39] fp-device: Ensure that devices have no path segment

We may have checked for G_DIR_SEPARATOR, but we're fine if a device has
subpaths, not if trying to access to some parent path instead
---
 libfprint/fp-device.c | 6 ++++++
 1 file changed, 6 insertions(+)

