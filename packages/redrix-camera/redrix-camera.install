# shellcheck shell=bash
# pacman install script for redrix-camera

post_install() {
  udevadm trigger --subsystem-match=dma_heap >/dev/null 2>&1
  echo ":: redrix-camera: restart WirePlumber (systemctl --user restart wireplumber)"
  echo "   or log out and in, then test with: cam --list"
  echo "   Browsers need WebRtcPipeWireCamera: run user-config/apply from omarchy-redrix."
}

post_upgrade() {
  post_install
}
